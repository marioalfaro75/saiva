# Secrets / env
.env

# The deploy's own state when it cannot use /var/lib (developer checkouts only).
.saiva-state/
# The .env transaction's working files. Normally renamed away within milliseconds; a
# process killed mid-write leaves one, and it is a full copy of .env -- SECRET_KEY,
# POSTGRES_PASSWORD and the rest -- sitting in the working tree.
.env.staging.*
.env.w.*
*.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.sqlite3
*.db

# Node / frontend
node_modules/
dist/
dist-ssr/
*.local
.vite/
coverage/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# TS build info
*.tsbuildinfo

# Database dumps. Nothing in this repository should ever hold one -- they are a household's
# complete financial history, they live in the db_backups volume and in whatever off-box
# destination is configured, and a stray `docker cp` into the checkout is how one gets
# committed by accident.
*.sql
*.sql.gz
