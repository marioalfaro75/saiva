# Saiva configuration — copy to `.env` and edit. NEVER commit `.env`.

# --- Required ---
# Long random string used to sign session cookies. Generate e.g. `openssl rand -hex 32`.
# Signs your session cookies and encrypts stored AI keys. Generate a real one — the
# app refuses to start in production on a placeholder:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# --- Site / TLS (Caddy) ---
# `localhost`            -> HTTPS on this machine only (default).
# `https://192.168.1.50` -> reachable over your LAN (internal CA). `make deploy LAN=1`
#                           sets this and SAIVA_SITE_HOST to your detected IP automatically.
# `finance.example.com`  -> public domain; set SAIVA_TLS to your email for Let's Encrypt.
SAIVA_SITE_ADDRESS=localhost
# Bare host (no scheme), used as the TLS default_sni so connecting by IP works.
SAIVA_SITE_HOST=localhost
# `internal` (Caddy's local CA, for localhost/LAN) or your email address (Let's Encrypt).
SAIVA_TLS=internal

# --- Database ---
POSTGRES_USER=saiva
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=saiva

# --- Application ---
# Which host interface Caddy publishes on. 127.0.0.1 keeps the app to this machine;
# `make deploy --lan` sets 0.0.0.0 for you. Docker bypasses host firewalls, so this is
# the setting that actually decides who can reach Saiva.
SAIVA_BIND_ADDR=127.0.0.1

ENVIRONMENT=production
# Send the session cookie only over HTTPS. Keep `true` in production.
COOKIE_SECURE=true
# Extra comma-separated CORS origins. Usually empty in production (same-origin behind Caddy).
CORS_ORIGINS=

# --- Updates ---
# Which published image to run. `latest` tracks tagged releases (v*); `edge` tracks
# the newest green build of main (continuous). Used by docker-compose.prod.yml.
#
# Note that `edge` and `sha-` builds carry no release number, so the app can tell you
# which build you are on but cannot tell you whether a newer release exists. The panel
# says that rather than showing a tick, which is what it used to do.
SAIVA_VERSION=latest

# Exact image references, which override SAIVA_VERSION entirely. Normally empty.
#
# These are what a rollback writes. Restoring the previous .env is not a rollback on the
# `latest` channel, because by the time you want to go back, `latest` already points at
# the release you are going back from -- so scripts/deploy.sh records the resolved
# DIGEST of every service before it changes anything, and pins these to those digests if
# it has to put the box back. A successful update clears them again, so a pin can never
# become the permanent state the old documented rollback left behind.
#
# Set one by hand to hold a service still (e.g. SAIVA_DB_IMAGE=postgres:16.9-alpine).
SAIVA_API_IMAGE=
SAIVA_WEB_IMAGE=
SAIVA_DB_IMAGE=
SAIVA_CADDY_IMAGE=

# Where the updater keeps its request file, its status and its rollback records. The api
# and caddy containers bind-mount it; scripts/install-updater.sh creates it. Changing
# this means changing it in both places, so leave it alone unless you have a reason.
SAIVA_STATE_DIR=/var/lib/saiva/update

# Set to false to disable the app's GitHub update check (a public, data-free request).
UPDATE_CHECK_ENABLED=true

# Nothing prunes images automatically, and each update applied holds onto roughly 140 MB,
# because the image a rollback would use is dangling by definition -- the tag it had has
# moved to the release that replaced it. `docker system df` shows where you are;
# `docker image prune` reclaims it once a release has proved itself. Deliberately not
# something the deploy does: a prune in the deploy path deletes exactly the thing that
# makes an offline rollback possible.

# --- Safety backups ---
# Before applying DB migrations on startup, write a compressed pg_dump to the
# db_backups volume (mounted at SAIVA_BACKUP_DIR). Set to 0 to skip. If the dump
# fails the container refuses to migrate, so an upgrade is always reversible.
#
# That covers an UPDATE. It does not cover a disk failing at 3am, which is what the
# nightly regime below is for. The two write into the same volume in the same format, so
# ./scripts/restore-backup.sh restores either without knowing the difference.
SAIVA_BACKUP_BEFORE_MIGRATE=1
SAIVA_BACKUP_DIR=/backups

# --- Nightly backups ---
# Taken by scripts/backup.sh on the HOST (a systemd timer installed by
# scripts/install-updater.sh), not by any container -- the thing that produces the safety
# net must not be the thing a bad release can break, and a backup is most wanted on the
# night the api container will not start.
#
# How old the newest VERIFIED backup may be before Settings stops calling it current. A
# nightly regime makes anything past one missed night worth saying out loud; 36 hours
# leaves room for a reboot and a randomised timer without crying wolf. The API hands this
# number to the page, so the policy lives here and not in two places.
SAIVA_BACKUP_STALE_HOURS=36

# Where the backup goes AFTER this box, how many to keep, and anything else root acts on,
# all live in /etc/saiva/agent.conf instead of here -- on purpose. A destination path or a
# copy command read from this file and then run as root would hand root to anyone who can
# write the checkout. See docs/BACKUPS.md.

# --- Email & alerts (optional) ---
# SMTP is what powers alert emails and digests. Leave SMTP_HOST empty to keep all
# email off (in-app alerts still work). SMTP_FROM is required to enable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true   # STARTTLS (port 587). Set SMTP_SSL=true instead for implicit TLS (465).
SMTP_SSL=false
# Token the scheduler passes to POST /api/notifications/run to generate alerts and
# send due digests, e.g. a cron line:
#   */30 * * * *  curl -fsS -X POST -H "X-Notify-Token: $TOKEN" https://<host>/api/notifications/run
NOTIFICATIONS_TOKEN=

# --- Rate limiting ---
# Per-caller, per-minute ceilings; 0 disables one. Credentials cover login, first-run
# setup and password change. The others are the endpoints that cost the most per
# request, each with its own bucket so exhausting one cannot lock you out of another.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_IMPORT_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_REPORT_PER_MINUTE=30

# Reverse proxies whose X-Forwarded-For may be believed: comma-separated IPs, CIDRs
# or hostnames. Behind a proxy the peer address is the proxy, so without this every
# visitor shares one rate-limit bucket and every audit-log row records the same
# address. Empty means trust nothing and use the peer address — correct when nothing
# fronts the API, and the safe default, since a client can send that header itself.
TRUSTED_PROXIES=caddy

# --- HSTS ---
# Set by scripts/deploy.sh from the certificate actually in use, and left at 0 with
# Caddy's internal CA: a non-zero max-age there turns the untrusted-certificate
# warning into a dead end with no way past it. A publicly trusted certificate gets a
# year (31536000).
SAIVA_HSTS_MAX_AGE=0
