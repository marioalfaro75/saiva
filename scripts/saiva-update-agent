#!/usr/bin/env bash
# The host side of the in-app "Update now" button.
#
# This is the only piece of Saiva that runs outside a container, and it is deliberately
# the smallest thing that can do the job. It does four things: notice that a request
# file exists, delete it, and run `scripts/deploy.sh --apply-release` in the checkout
# with no arguments. That is the whole program.
#
# WHY IT TAKES NO PARAMETERS. The api container is reachable from the network. It can
# write one file into one directory, and nothing in that file selects what gets
# deployed: the target release is resolved here, from the tags on `origin`. So the most
# a compromised api container can ask for is the update the button was going to do
# anyway. The alternative -- letting the request name a ref, a branch or a command --
# turns "a container can write a file" into "a container can make root run arbitrary
# code", which is not a trade worth making for a convenience feature.
#
# WHY IT IS A COPY AND NOT A SYMLINK INTO THE CHECKOUT. Whatever applies updates cannot
# apply its own updates the same way. If this file lived in the checkout, every release
# would be able to change what runs as root on the box, and `git checkout` would be a
# privilege escalation. So scripts/install-updater.sh COPIES it to /usr/local/lib/saiva
# and a human re-runs that installer when it changes. The cost is that it can go stale,
# and the mitigation is `--self-check`, which says so out loud rather than leaving you
# to find out.
#
#   saiva-update-agent             apply an update if one has been requested, then exit
#   saiva-update-agent --watch     the same, in a poll loop (for hosts without systemd)
#   saiva-update-agent --self-check  report config, paths, and whether this copy is stale
set -euo pipefail

AGENT_VERSION=1
CONF="${SAIVA_AGENT_CONF:-/etc/saiva/agent.conf}"

die() { printf 'saiva-update-agent: %s\n' "$*" >&2; exit 1; }

load_conf() {
  [ -r "$CONF" ] || die "$CONF is missing or unreadable. Run scripts/install-updater.sh."
  # The config file is root-owned and sets two values. It is not a place to put logic;
  # anything sourced here runs as root.
  # shellcheck disable=SC1090
  . "$CONF"
  [ -n "${SAIVA_CHECKOUT:-}" ] || die "SAIVA_CHECKOUT is not set in $CONF"
  [ -d "$SAIVA_CHECKOUT/.git" ] || die "SAIVA_CHECKOUT ($SAIVA_CHECKOUT) is not a git checkout"
  [ -x "$SAIVA_CHECKOUT/scripts/deploy.sh" ] || die "no deploy script at $SAIVA_CHECKOUT/scripts/deploy.sh"
  STATE="${SAIVA_STATE_DIR:-/var/lib/saiva/update}"
  REQUEST="$STATE/request"
}

apply_once() {
  [ -f "$REQUEST" ] || return 0

  # Consume the request BEFORE doing any work. If the update fails, or this process is
  # killed, the request must not still be sitting there for the path unit to re-trigger
  # on: that is how a failing release becomes an infinite loop of failing releases.
  local requested_by
  requested_by="$(head -c 200 "$REQUEST" 2>/dev/null | tr -d '\000-\037' || true)"
  rm -f "$REQUEST"
  printf 'saiva-update-agent: request consumed (%s)\n' "${requested_by:-no detail}"

  # `requested_by` is recorded in the log and used for NOTHING else. It is written by a
  # network-facing container; it is evidence, not instruction.
  cd "$SAIVA_CHECKOUT"
  exec env \
    SAIVA_UPDATE_TRIGGER=button \
    SAIVA_STATE_DIR="$STATE" \
    "$SAIVA_CHECKOUT/scripts/deploy.sh" --apply-release
}

watch_loop() {
  local interval="${SAIVA_AGENT_POLL_SECONDS:-5}"
  printf 'saiva-update-agent: watching %s every %ss\n' "$REQUEST" "$interval"
  while true; do
    if [ -f "$REQUEST" ]; then
      # A subshell, because apply_once execs: in --watch mode the loop has to survive
      # the update it just ran.
      ( apply_once ) || printf 'saiva-update-agent: update exited non-zero\n' >&2
    fi
    sleep "$interval"
  done
}

self_check() {
  printf 'agent version   : %s\n' "$AGENT_VERSION"
  printf 'config          : %s\n' "$CONF"
  printf 'checkout        : %s\n' "${SAIVA_CHECKOUT:-<unset>}"
  printf 'state directory : %s\n' "$STATE"
  printf 'request file    : %s%s\n' "$REQUEST" "$([ -f "$REQUEST" ] && printf ' (one is pending)' || true)"
  printf 'writable by     : %s\n' "$(stat -c '%U:%G %a' "$STATE" 2>/dev/null || echo '<missing>')"

  local in_tree="$SAIVA_CHECKOUT/scripts/saiva-update-agent"
  if [ -r "$in_tree" ] && ! cmp -s "$in_tree" "$0"; then
    printf '\nSTALE: the checkout ships a different version of this agent.\n'
    printf 'This copy runs as root and is not updated by a release, on purpose.\n'
    printf 'Read the difference, then re-install it:\n'
    printf '  diff %s %s\n' "$0" "$in_tree"
    printf '  sudo %s/scripts/install-updater.sh\n' "$SAIVA_CHECKOUT"
    return 1
  fi
  printf '\nup to date with the checkout\n'
  return 0
}

case "${1:-once}" in
  once)         load_conf; apply_once ;;
  --watch)      load_conf; watch_loop ;;
  --self-check) load_conf; self_check ;;
  -h|--help)    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)            die "unknown argument: $1" ;;
esac
