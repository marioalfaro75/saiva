# Edge reverse proxy.
#   SAIVA_SITE_ADDRESS=localhost              -> HTTPS on this machine (internal CA)
#   SAIVA_SITE_ADDRESS=https://192.168.1.50   -> LAN access (internal CA); `make deploy LAN=1`
#   SAIVA_SITE_ADDRESS=finance.example.com    -> public domain; set SAIVA_TLS=you@email.com
#
# SAIVA_SITE_HOST is the bare host (no scheme), used as `default_sni` so TLS still works when
# a client connects by IP — IP literals carry no SNI, so without this Caddy can't pick a cert.
# SAIVA_TLS is `internal` (Caddy's local CA, for localhost/LAN) or an email (Let's Encrypt).
{
	default_sni {$SAIVA_SITE_HOST:localhost}
	servers {
		protocols h1 h2
	}
}

{$SAIVA_SITE_ADDRESS:localhost} {
	encode gzip
	tls {$SAIVA_TLS:internal}

	# The updater's status, served straight off the host filesystem.
	#
	# This is deliberately NOT proxied to the api container, and that is the whole point
	# of it. An update replaces the api container; the old design had that container
	# report on its own replacement, so the process that would say what happened was the
	# process being killed, and the panel rendered "Update applied." whatever had
	# actually occurred. Here the state lives in a file the host's updater writes, so a
	# container dying is a gap in the transport and not a loss of the answer — and this
	# route still answers while api is down, which is exactly when somebody needs it.
	#
	# It is unauthenticated, so it carries only the redacted record: phase, step,
	# timestamps, release versions and one sentence. No digests, no git revisions, no log
	# output, nothing from .env — scripts/lib/state.sh fixes that list, and the deploy
	# tests assert on it. Every version that exists is already public on GitHub, so the
	# only thing disclosed is which one this box runs; being able to read "failed at the
	# gate, rolled back" from a browser when nothing else answers is worth more than that.
	handle /_saiva/update-status.json {
		root * /srv/saiva-update
		rewrite * /status-public.json
		file_server
		header Cache-Control "no-store"
		header Content-Type "application/json"
	}

	# API
	handle /api/* {
		reverse_proxy api:8000
	}

	# Single-page app (static, with client-side routing fallback handled by the web service)
	handle {
		reverse_proxy web:8080
	}

	# Defense-in-depth headers (the API sets its own too).
	#
	# HSTS is set from SAIVA_HSTS_MAX_AGE, which deploy.sh derives from the certificate
	# actually in use. It defaults to 0 — meaning "forget any HSTS for this host" —
	# because with the internal CA a non-zero max-age turns the untrusted-certificate
	# warning into a dead end with no "proceed" button, on a LAN address that may later
	# belong to something else entirely. With a real certificate from Let's Encrypt the
	# deploy sets a year, which is what stops a downgrade to plain HTTP.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age={$SAIVA_HSTS_MAX_AGE:0}"
		-Server
	}
}
